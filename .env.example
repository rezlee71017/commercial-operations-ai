# Copy this file to app/.env.local and fill in the values. Never commit real keys.

# Gemini API key from Google AI Studio (new keys start with "AQ."). Required unless LLM_MODE=mock.
GEMINI_API_KEY=
# Optional. Default: gemini-3.5-flash-lite
GEMINI_MODEL=

# Optional switches
# LLM_MODE=mock       use the built-in test double instead of Gemini
# AGENT_MODE=tools    use the tool-using agent (every tool call becomes a recorded event)

# Optional: hosted Postgres, for example the Supabase "pooler" connection string.
# Leave empty to use the local database in app/.data (see docs/supabase.md).
DATABASE_URL=
# DB_DIR=.data/pgdata
# DB_POOL_MAX=5
