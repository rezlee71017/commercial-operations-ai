# Copy this file to app/.env.local and fill in the values. Never commit real keys.

# Gemini API key from Google AI Studio (new keys start with "AQ."). Required unless LLM_MODE=mock.
GEMINI_API_KEY=
# Optional. Default: gemini-3.5-flash-lite
GEMINI_MODEL=

# OpenRouter (https://openrouter.ai/keys). Optional: used as the automatic fallback when Gemini is rate limited,
# slow or unavailable, and by the Python AI service. Free models allow 20 requests/minute and a small daily cap,
# and free models rotate, so the default "openrouter/free" router is used unless you pin a model.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_FALLBACK_MODELS=model-a:free,model-b:free

# Which provider the TypeScript agent uses. Default: Gemini, with OpenRouter as fallback when its key is set.
# LLM_PROVIDER=openrouter    use OpenRouter only

# Python AI service (ai-service/). The web app calls it server-side from POST /api/assistant.
# AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=

# Check the connections without printing keys:  cd app && npm run check:llm

# Optional switches
# LLM_MODE=mock       use the built-in test double instead of Gemini
# AGENT_MODE=tools    use the tool-using agent (every tool call becomes a recorded event)

# Optional: hosted Postgres, for example the Supabase "pooler" connection string.
# Leave empty to use the local database in app/.data (see docs/supabase.md).
DATABASE_URL=
# DB_DIR=.data/pgdata
# DB_POOL_MAX=5

# Secret for operator-only API endpoints (decisions, summary, rules, inventory with cost).
# Leave empty in local development (endpoints stay open). REQUIRED in production, otherwise they answer 503.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
OPERATOR_TOKEN=
