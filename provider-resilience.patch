diff --git a/app/src/core/gemini-http.test.ts b/app/src/core/gemini-http.test.ts
new file mode 100644
index 0000000..9ca21c8
--- /dev/null
+++ b/app/src/core/gemini-http.test.ts
@@ -0,0 +1,78 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { geminiFetch, parseRetryDelayMs, ProviderError } from "./gemini-http";
+import { redactForCustomer } from "./redact";
+import { runWorkflow } from "./run";
+import { seedProducts, defaultRules } from "../data/seed-data";
+
+afterEach(() => vi.unstubAllGlobals());
+
+const rateLimitBody = (delay: string) =>
+  JSON.stringify({ error: { code: 429, details: [{ "@type": "type.googleapis.com/google.rpc.RetryInfo", retryDelay: delay }] } });
+
+describe("Gemini HTTP helper (fake network, NOT the real API)", () => {
+  it("reads the wait time Gemini asks for", () => {
+    expect(parseRetryDelayMs(rateLimitBody("40s"))).toBe(41_000);
+    expect(parseRetryDelayMs("Please retry in 22.5s.")).toBe(23_500);
+    expect(parseRetryDelayMs("nothing here")).toBeNull();
+  });
+
+  it("waits and retries after a 429, then succeeds", async () => {
+    const replies = [new Response(rateLimitBody("20s"), { status: 429 }), new Response("{}", { status: 200 })];
+    vi.stubGlobal("fetch", async () => replies.shift()!);
+    const sleep = vi.fn(async () => undefined);
+    const res = await geminiFetch("http://x", {}, { sleep });
+    expect(res.ok).toBe(true);
+    expect(sleep).toHaveBeenCalledWith(21_000);
+  });
+
+  it("does not wait when Gemini asks for longer than the limit: fails fast as rate_limited", async () => {
+    vi.stubGlobal("fetch", async () => new Response(rateLimitBody("120s"), { status: 429 }));
+    const sleep = vi.fn(async () => undefined);
+    const err = await geminiFetch("http://x", {}, { sleep }).catch((e) => e);
+    expect(err).toBeInstanceOf(ProviderError);
+    expect(err.kind).toBe("rate_limited");
+    expect(sleep).not.toHaveBeenCalled();
+  });
+
+  it("gives up after the maximum number of retries", async () => {
+    let calls = 0;
+    vi.stubGlobal("fetch", async () => (calls++, new Response(rateLimitBody("1s"), { status: 429 })));
+    const err = await geminiFetch("http://x", {}, { sleep: async () => undefined, maxRetries: 2 }).catch((e) => e);
+    expect(err.kind).toBe("rate_limited");
+    expect(calls).toBe(3);
+  });
+
+  it("does not retry a wrong key (401) and classifies it as auth", async () => {
+    let calls = 0;
+    vi.stubGlobal("fetch", async () => (calls++, new Response("denied", { status: 401 })));
+    const err = await geminiFetch("http://x", {}, { sleep: async () => undefined }).catch((e) => e);
+    expect(err.kind).toBe("auth");
+    expect(calls).toBe(1);
+  });
+
+  it("maps a timeout to a timeout error", async () => {
+    vi.stubGlobal("fetch", async () => {
+      throw new DOMException("timed out", "TimeoutError");
+    });
+    const err = await geminiFetch("http://x", {}, { timeoutMs: 5 }).catch((e) => e);
+    expect(err.kind).toBe("timeout");
+  });
+
+  it("a provider failure shows the customer a safe message and keeps the detail for the operator only", async () => {
+    const propose = async () => {
+      throw new ProviderError("rate_limited", 429, "quota exceeded for project 12345, see https://ai.dev/billing");
+    };
+    const result = await runWorkflow("any request", seedProducts, defaultRules, { propose }, []);
+    expect(result.status).toBe("failed");
+    const failed = result.events.find((e) => e.status === "failed")!;
+    const data = failed.data as { error: string; code: string; providerDetail: string };
+    expect(data.code).toBe("rate_limited");
+    expect(data.error).not.toContain("quota");
+    expect(data.providerDetail).toContain("quota exceeded");
+
+    const customerView = JSON.stringify(redactForCustomer(failed));
+    expect(customerView).not.toContain("quota");
+    expect(customerView).not.toContain("billing");
+    expect(customerView).toContain("busy right now");
+  });
+});
diff --git a/app/src/core/gemini-http.ts b/app/src/core/gemini-http.ts
new file mode 100644
index 0000000..a829057
--- /dev/null
+++ b/app/src/core/gemini-http.ts
@@ -0,0 +1,70 @@
+// One place for every HTTP call to Gemini: timeout, polite retry on rate limits, and errors
+// that are safe to show to a customer. The technical detail is kept for the operator.
+
+export type ProviderErrorKind = "rate_limited" | "timeout" | "unavailable" | "auth" | "bad_request";
+
+const PUBLIC_MESSAGES: Record<ProviderErrorKind, string> = {
+  rate_limited: "The AI service is busy right now. Please try again in a minute.",
+  timeout: "The AI service took too long to answer. Please try again.",
+  unavailable: "The AI service is temporarily unavailable. Please try again.",
+  auth: "The AI service is not configured correctly. Please contact the store.",
+  bad_request: "The AI service could not process this request. Please try again.",
+};
+
+export class ProviderError extends Error {
+  readonly publicMessage: string;
+  constructor(
+    public readonly kind: ProviderErrorKind,
+    public readonly status: number | undefined,
+    detail: string,
+  ) {
+    super(`Gemini HTTP ${status ?? "none"} (${kind}): ${detail.slice(0, 500)}`);
+    this.name = "ProviderError";
+    this.publicMessage = PUBLIC_MESSAGES[kind];
+  }
+}
+
+// Gemini says how long to wait, either as "retryDelay": "40s" or as "Please retry in 40.7s".
+export function parseRetryDelayMs(body: string): number | null {
+  const m = body.match(/"retryDelay":\s*"(\d+(?:\.\d+)?)s"/) ?? body.match(/retry in (\d+(?:\.\d+)?)s/i);
+  return m ? Math.ceil(Number(m[1]) * 1000) + 1000 : null; // +1s safety margin
+}
+
+export type FetchOptions = {
+  timeoutMs?: number; // per attempt
+  maxRetries?: number; // extra attempts after the first one
+  maxWaitMs?: number; // never wait longer than this for a retry: fail fast instead
+  sleep?: (ms: number) => Promise<void>; // injectable for tests
+};
+
+export async function geminiFetch(url: string, init: RequestInit, opts: FetchOptions = {}): Promise<Response> {
+  const { timeoutMs = 30_000, maxRetries = 2, maxWaitMs = 45_000 } = opts;
+  const sleep = opts.sleep ?? ((ms: number) => new Promise<void>((r) => setTimeout(r, ms)));
+
+  for (let attempt = 0; ; attempt++) {
+    let res: Response;
+    try {
+      res = await fetch(url, { ...init, signal: AbortSignal.timeout(timeoutMs) });
+    } catch (e) {
+      const name = e instanceof Error ? e.name : "";
+      if (name === "TimeoutError" || name === "AbortError") {
+        throw new ProviderError("timeout", undefined, `no answer within ${timeoutMs}ms`);
+      }
+      throw new ProviderError("unavailable", undefined, e instanceof Error ? e.message : String(e));
+    }
+    if (res.ok) return res;
+
+    const body = await res.text().catch(() => "");
+    if (res.status === 429 || res.status === 503) {
+      const wait = parseRetryDelayMs(body) ?? 2000 * 2 ** attempt;
+      if (attempt < maxRetries && wait <= maxWaitMs) {
+        await sleep(wait);
+        continue;
+      }
+      throw new ProviderError(res.status === 429 ? "rate_limited" : "unavailable", res.status, body);
+    }
+    if (res.status === 401 || res.status === 403) throw new ProviderError("auth", res.status, body);
+    if (res.status >= 500) throw new ProviderError("unavailable", res.status, body);
+    throw new ProviderError("bad_request", res.status, body);
+  }
+}
